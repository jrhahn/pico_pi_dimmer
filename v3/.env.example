# Compiled into the firmware. Copy to `.env` (git-ignored); direnv loads it.
SSID="MyNetwork"
PASSWORD="s3cret"

# Broker host name or IPv4 address, port 1883.
MQTT_BROKER="192.168.1.10"
# Leave unset for an anonymous broker.
#MQTT_USER="dimmer"
#MQTT_PASSWORD="change-me"

# Topic level (smarthome/<NODE_ID>/...) and the device name in Home Assistant.
#NODE_ID="dimmer"
#NODE_NAME="Dimmer"

# From `python ota.py keygen`; without it the firmware takes no updates over Wi-Fi.
#OTA_PUBLIC_KEY="..."

# ota.py push puts images on a server the dimmers can reach over HTTP.
#OTA_SSH="admin@family-server"
#OTA_DIR="/var/lib/smarthome-firmware"
#OTA_URL="http://192.168.1.67/fw"
